FROM node:22-alpine AS build

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

WORKDIR /build

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/ksef-downloader/package.json ./packages/ksef-downloader/

RUN pnpm install --frozen-lockfile

COPY tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY packages/ksef-downloader ./packages/ksef-downloader

RUN pnpm --filter @ksef-export/shared build
RUN pnpm --filter @ksef-export/ksef-downloader build

# ──────────────────────────────────────────────
FROM node:22-alpine AS runtime

WORKDIR /app

COPY --from=build /build/packages/ksef-downloader/dist/main.js ./main.js

USER node

ENTRYPOINT ["node", "/app/main.js"]
