FROM node:22-alpine AS build

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

WORKDIR /build

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/sink-gdrive/package.json ./packages/sink-gdrive/

RUN pnpm install --frozen-lockfile

COPY tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY packages/sink-gdrive ./packages/sink-gdrive

RUN pnpm --filter @ksef2gdrive/shared build
RUN pnpm --filter @ksef2gdrive/sink-gdrive build

# ──────────────────────────────────────────────
FROM node:22-alpine AS runtime

WORKDIR /app

COPY --from=build /build/packages/sink-gdrive/dist/main.js ./main.js

USER node

EXPOSE 8080

ENTRYPOINT ["node", "/app/main.js"]
