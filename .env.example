# KSeF credentials
KSEF_TOKEN=your-ksef-token-here
KSEF_NIP=0000000000
KSEF_ENV=prod   # prod | test

# ── Google Drive auth ────────────────────────────────────────────────────────
# Pick ONE of the two methods below. If GOOGLE_SERVICE_ACCOUNT_KEY is set the
# service-account method is used automatically; otherwise OAuth is used.

# Option A: Service account (recommended for CI / GH Actions)
# Download a service account JSON key from Google Cloud Console and share the
# target Drive folder with the service account email.
# GOOGLE_SERVICE_ACCOUNT_KEY=/secrets/google_sa_key.json

# Option B: OAuth user credentials (recommended for personal use)
# Download an OAuth client JSON from Google Cloud Console (Desktop app type).
# On first run you will be prompted to authorize in a browser.
GOOGLE_OAUTH_CLIENT_SECRETS=/secrets/google_client.json
GOOGLE_TOKEN_CACHE=/data/gdrive_token.json

# Optional: enable verbose debug logging
# DEBUG=1
